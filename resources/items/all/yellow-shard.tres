[resource]
script = ExtResource("1_n53uw")
Name = "yellow-shard"
Id = 74
Category = "collectibles"
Attributes = PackedStringArray("underground")
ShortEffect = "No effect. Can be traded for items or moves."
Effect = "No effect.  In Diamond and Pearl, trade ten for a Sandstorm TM in the house midway along the southern section of Route 212.  In Platinum, trade to move tutors on Route 212, in Snowpoint City, and in the Survival Area.  Eight shards total are required per tutelage, but the particular combination of colors varies by move.  In HeartGold and SoulSilver, trade one for an Aspear Berry, a Iapapa Berry, and a Sitrus Berry with the Juggler near the Pokémon Center in Violet City.  In HeartGold and SoulSilver, trade one for a Grepa Berry, a Nomel Berry, and a Pinap Berry with the Juggler near the Pal Park entrance in Fuchsia City."
FlingPower = 30
Sprite = SubResource("ImageTexture_oru50")
