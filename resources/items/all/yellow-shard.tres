[resource]
script = ExtResource("1_n53uw")
Name = "yellow-shard"
Id = 74
Cost = 1000
Category = "collectibles"
Attributes = PackedStringArray("underground")
ShortEffect = "No effect. Can be traded for items or moves."
Effect = "No effect.  In Diamond and Pearl, trade ten for a sandstorm TM in the house midway along the southern section of sinnoh route 212.  In Platinum, trade to move tutors on sinnoh route 212, in snowpoint city, and in the survival area.  Eight shards total are required per tutelage, but the particular combination of colors varies by move.  In HeartGold and SoulSilver, trade one for an aspear berry, a iapapa berry, and a sitrus berry with the Juggler near the Pokémon Center in violet city.  In HeartGold and SoulSilver, trade one for a grepa berry, a nomel berry, and a pinap berry with the Juggler near the pal park entrance in fuchsia city."
FlingPower = 30
Sprite = SubResource("ImageTexture_oru50")
