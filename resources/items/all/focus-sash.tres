[resource]
script = ExtResource("1_muueb")
Name = "focus-sash"
Id = 252
Cost = 4000
Category = "held-items"
Attributes = PackedStringArray("holdable", "holdable-active")
ShortEffect = "Held: Holder survives any single-hit attack at 1 HP if at max HP, then the item is consumed."
Effect = "Held: If the holder has full HP and is attacked for regular damage that would faint it, this item is consumed and prevents the holder’s HP from lowering below 1.  This effect works against multi-hit attacks, but does not work against the effects of Doom Desire or Future Sight."
FlingPower = 10
Sprite = SubResource("ImageTexture_oxgyk")
