; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pokemon xy c"
run/main_scene="uid://k2c2g7m7kfqt"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://scripts/core/Globals.cs"
Signals="*res://scripts/core/Signals.cs"
SceneManager="*res://scripts/core/SceneManager.cs"
SaveManager="*res://scripts/core/SaveManager.cs"
BattleManager="*res://scripts/core/BattleManager.cs"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Pokemon xy c"

[editor_plugins]

enabled=PackedStringArray("res://addons/MoveImporter/plugin.cfg", "res://addons/PokemonImporter/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/item_importer/plugin.cfg", "res://addons/itemimporter/plugin.cfg")

